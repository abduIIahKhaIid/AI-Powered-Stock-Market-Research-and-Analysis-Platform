# Copy this file to .env and change the values. Never commit .env.

APP_ENV=development

# PostgreSQL (used by the postgres container and the API)
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stock
DATABASE_URL=postgresql://stock:change-me@postgres:5432/stock

# Redis: Celery broker, cache and progress pub/sub
REDIS_URL=redis://redis:6379/0

# Custom Financial Analysis MCP server
MCP_SERVER_URL=http://mcp:8100/mcp
MCP_HEALTH_URL=http://mcp:8100/health
# NASDAQ symbol directory (refreshed daily, cached in MCP_CACHE_DIR)
NASDAQ_DIRECTORY_URL=https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt

# Browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# LLM gateway. Providers: ollama, groq, gemini, openai, openrouter, anthropic, custom.
# Use a model with native tool calling (qwen3:8b, llama3.1:8b ...).
#
# Option A - Ollama on Google Colab exposed with ngrok (notebooks/ollama_colab_ngrok.ipynb):
#   LLM_API_BASE=https://<your-id>.ngrok-free.app   (the gateway adds /v1 and the ngrok header)
# Option B - Ollama on this computer: LLM_API_BASE=http://host.docker.internal:11434
#   (from Docker) or http://localhost:11434 (without Docker)
# Option C - hosted API: set LLM_PROVIDER, LLM_MODEL and LLM_API_KEY; leave LLM_API_BASE empty.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_API_BASE=https://your-id.ngrok-free.app
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
# Extra headers as JSON, e.g. {"X-Team": "stock"}
# LLM_EXTRA_HEADERS={}
# USD per million tokens, only for cost logging (0 for local models)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Optional fallback used when the primary cannot be reached (e.g. the Colab session ended)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_PRICE_INPUT_PER_MTOK=0
LLM_FALLBACK_PRICE_OUTPUT_PER_MTOK=0
# After the primary fails as unreachable, use the fallback first for this many seconds
LLM_PRIMARY_COOLDOWN_SECONDS=120

# Agent harness: per-question budgets and conversation memory
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_RESULT_MAX_CHARS=6000
AGENT_HISTORY_MESSAGES=8
CONVERSATION_TTL_SECONDS=604800
MCP_CALL_TIMEOUT=60

# --- Filled in by later stories ---

# SEC EDGAR (SCRUM-21): descriptive User-Agent with a contact email is required
SEC_USER_AGENT="Your Name your.email@example.com"

# Alpha Vantage MCP (SCRUM-22)
ALPHAVANTAGE_API_KEY=
